# syntax=docker/dockerfile:1
# =============================================================================
# Dockerfile —— MultiModalSDK 门禁 PreSmoke 任务镜像
#
# 目标镜像 : swr.cn-north-4.myhuaweicloud.com/ascend-mindx/mindx_image:multimodalsdk-presmoke-aarch64-<yyyymmddHHMM>
# 使用位置 : .gitcode/workflows/.presmoke.yml -> container.image (IMAGE_FLAG)
#
# 底座 : multimodalsdk-aarch64（Build_Arm / UT_cpp 合并镜像）
#        = CANN toolkit 8.3.RC2 + Python3.11.4 + torch-npu 2.9.1。
#        base 复用同一底座以减少重复层，vllm 运行环境在本镜像内叠加安装。
#
# vllm 依赖（据 2026-11-23 门禁失败 run 6fbb9f5dfa6740eabba175125750a1f8 修正）：
#   test/presmoke/mm_acc/vllm/test_vllm.py 会在 NPU 节点以子进程真实启动
#   `vllm serve`（OpenAI 兼容服务）并对 image / video 做多模态推理
#   （fixture vllm_server -> subprocess.Popen(['vllm','serve',...])）。
#   因此 presmoke 镜像必须预置可用的 vllm + vllm-ascend 运行环境；
#   原先「vllm / vllm-ascend / mooncake / triton 全链路对 presmoke 冗余」的裁剪
#   判断已被该失败证伪（报错：FileNotFoundError: 'vllm'）。
#
#   版本与历史可用的 presmoke 环境（mindx_arm:vllm-ascend_v0.23.0rc1）对齐：
#     vllm 0.23.0 / vllm-ascend 0.23.0rc1 / triton-ascend 3.2.1。
# =============================================================================

# 底座由 ci-infra 产出；此处给定默认值，构建时可通过 --build-arg BASE_IMAGE=<实际 tag> 覆盖。
ARG BASE_IMAGE=swr.cn-north-4.myhuaweicloud.com/ascend-mindx/mindx_image:multimodalsdk-aarch64-202611230343
FROM ${BASE_IMAGE}

# 统一用 bash：ATB 安装层需 source set_env.sh 且依赖 pipefail
SHELL ["/bin/bash", "-c"]

ARG PIP_INDEX_URL=https://pypi.org/simple
ARG PIP_EXTRA_INDEX_URL=https://mirrors.huaweicloud.com/ascend/repos/pypi

WORKDIR /workspace

# 编译工具链：arctic-inference==0.1.1（vllm-ascend==0.23.0rc1 的强依赖，仅发布 sdist）
# 安装时需源码编译 C++ 扩展，其 csrc/suffix_decoding/suffix_tree.h 使用 C++20 的 <span>
# （pip 以 -std=gnu++2a 编译）。base 为兼容 AccSDK 编译把默认 c++/g++ 固定为 gcc-9，
# GCC 9 的 libstdc++ 无 <span>，直接报 `fatal error: span: No such file or directory`。
# 这里在 presmoke 层安装 g++-11 并切换默认工具链（仅影响本镜像，不动 base）。
RUN apt-get update && apt-get install -y --no-install-recommends gcc-11 g++-11 \
 && update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-11 110 \
 && update-alternatives --install /usr/bin/g++ g++ /usr/bin/g++-11 110 \
 && update-alternatives --set gcc /usr/bin/gcc-11 \
 && update-alternatives --set g++ /usr/bin/g++-11 \
 && rm -rf /var/lib/apt/lists/* /var/cache/apt/*

# =============================================================================
# ATB（Ascend Transformer Boost，由 CANN nnal 提供）运行时
#
# vllm_ascend worker 在 __init__ 中无条件执行
#   torch_npu.op_plugin.atb._atb_ops._register_atb_extensions()
#     -> torch.ops.load_library(${torch_npu}/lib/libop_plugin_atb.so)
#     -> 该 so 运行时依赖 libatb.so（ATB）
# 底座 Dockerfile.aarch64 只装 CANN 8.3.RC2 toolkit（明确不含 nnal/ATB），故 presmoke
# 镜像内缺少 libatb.so，报错链：
#   OSError: libatb.so: cannot open shared object file: No such file or directory
#     -> OSError: Could not load this library: .../torch_npu/lib/libop_plugin_atb.so
#     -> RuntimeError: Engine core initialization failed
#     -> vLLM server did not become ready within 600s（test_vllm.py 用例失败）
#
# 复现历史可用 presmoke 环境（swr.../mindx_arm:vllm-ascend_v0.23.0rc1，docker history
# 实锤 ATB_HOME_PATH=/usr/local/Ascend/nnal/atb/latest/atb/cxx_abi_1）的 CANN 9.0.1 +
# nnal(ATB) 组合：vllm-ascend 0.23.0rc1 要求 torch-npu 2.10.0.post2，该 torch-npu 与
# CANN 9.0.1/ATB 9.0.1 配套，故同步安装 CANN 9.0.1 toolkit（提供 9.0.1 运行时）+ nnal 9.0.1。
# =============================================================================
ARG CANN_VERSION=9.0.1
RUN set -euo pipefail \
 && wget -q --no-check-certificate \
        "https://ascend-repo.obs.cn-east-2.myhuaweicloud.com/CANN/CANN%20${CANN_VERSION}/Ascend-cann-toolkit_${CANN_VERSION}_linux-aarch64.run" \
        "https://ascend-repo.obs.cn-east-2.myhuaweicloud.com/CANN/CANN%20${CANN_VERSION}/Ascend-cann-nnal_${CANN_VERSION}_linux-aarch64.run" \
 && chmod +x Ascend-cann-*.run \
 && echo y | "./Ascend-cann-toolkit_${CANN_VERSION}_linux-aarch64.run" --install --force \
 && set +eu; source /usr/local/Ascend/ascend-toolkit/set_env.sh; set -eu \
 && echo y | "./Ascend-cann-nnal_${CANN_VERSION}_linux-aarch64.run" --install --force \
 && set +eu; [ -f /usr/local/Ascend/nnal/atb/set_env.sh ] && source /usr/local/Ascend/nnal/atb/set_env.sh --cxx_abi=1; set -eu \
 && rm -f Ascend-cann-*.run \
 && ATB_LIB_DIR="/usr/local/Ascend/nnal/atb/latest/atb/cxx_abi_1/lib" \
 && test -f "${ATB_LIB_DIR}/libatb.so" \
 && { printf '%s' "${LD_LIBRARY_PATH}" | tr ':' '\n' | grep -E '^/usr/local/Ascend' || true; \
      find /usr/local/Ascend -name 'libhccl.so' -printf '%h\n' 2>/dev/null || true; \
      echo "${ATB_LIB_DIR}"; \
      echo "/usr/local/Ascend/driver/lib64"; \
      echo "/usr/local/Ascend/driver/lib64/common"; \
      echo "/usr/local/Ascend/driver/lib64/driver"; } \
    | grep -vE '^$' | sort -u > /etc/ld.so.conf.d/ascend.conf \
 && ldconfig \
 && ldconfig -p | grep -q 'libhccl.so' \
 && ldconfig -p | grep -q 'libatb.so' \
 && echo "[INFO] Ascend libs resolved: $(ldconfig -p | grep -cE 'libhccl.so|libatb.so') (hccl/atb)"

# =============================================================================
# CANN / ATB 运行时环境变量（与历史可用 presmoke 镜像对齐）
#
# ★ 必须显式设置 LD_LIBRARY_PATH：base 镜像（CANN 8.3.RC2 toolkit）本身**不设**
#   LD_LIBRARY_PATH，运行时靠 CANN 安装器写入的 ld.so.cache 定位 lib64。本层安装
#   CANN 9.0.1 会替换 ascend-toolkit/latest，使原 8.3.RC2 的缓存项失效；若此处只给
#   ATB 目录而不含 9.0.1 的 lib64，torch_npu._C import 立即失败：
#     ImportError: libhccl.so: cannot open shared object file ... run 'source set_env.sh'
#   -> RuntimeError: Failed to load the backend extension: torch_npu（presmoke 12 errors）
#   故这里给出「CANN toolkit lib64 + driver lib64 + nnal ATB lib」完整路径，并用
#   ld.so.conf.d + ldconfig 双保险（上面已校验 libhccl.so / libatb.so 均可解析）。
# =============================================================================
ENV ATB_CXX_ABI=1
ENV ATB_HOME_PATH=/usr/local/Ascend/nnal/atb/latest/atb/cxx_abi_1
ENV ASCEND_HOME_PATH=/usr/local/Ascend/ascend-toolkit/latest
ENV ASCEND_TOOLKIT_HOME=/usr/local/Ascend/ascend-toolkit/latest
ENV ASCEND_OPP_PATH=/usr/local/Ascend/ascend-toolkit/latest/opp
ENV ASCEND_AICPU_PATH=/usr/local/Ascend/ascend-toolkit/latest
ENV PYTHONPATH=/usr/local/Ascend/ascend-toolkit/latest/python/site-packages
ENV LD_LIBRARY_PATH=/usr/local/Ascend/ascend-toolkit/latest/tools/aml/lib64:/usr/local/Ascend/ascend-toolkit/latest/tools/aml/lib64/plugin:/usr/local/Ascend/ascend-toolkit/latest/lib64:/usr/local/Ascend/ascend-toolkit/latest/lib64/plugin/opskernel:/usr/local/Ascend/ascend-toolkit/latest/lib64/plugin/nnengine:/usr/local/Ascend/driver/lib64:/usr/local/Ascend/driver/lib64/common:/usr/local/Ascend/driver/lib64/driver:/usr/local/Ascend/nnal/atb/latest/atb/cxx_abi_1/lib

# vllm 运行环境 + 测试依赖：
#   vllm                             —— test_vllm.py 需要可执行的 `vllm serve` 服务
#   vllm-ascend / triton-ascend       —— vllm 的 NPU 后端
#   mooncake-transfer-engine-npu     —— 历史 presmoke 环境的一部分（vllm-ascend 传输引擎）
#   pytest                           —— run_presmoke.sh 执行 python3 -m pytest test/presmoke/mm_acc/
#   librosa / einops                 —— 音频等用例 import
# 注意 1：vllm-ascend==0.23.0rc1 的依赖声明**不含 vllm**，必须显式安装 vllm 本体，
#         否则镜像内无 `vllm` 可执行文件（报错：FileNotFoundError: 'vllm'）。
# 注意 2：vllm 0.23.0 声明 torch==2.11.0，vllm-ascend 0.23.0rc1 声明 torch==2.10.0，
#         若写进同一条 pip install 会联合解析导致 ResolutionImpossible；故拆成两条
#         独立命令：先装 vllm（torch 2.11.0），再由 vllm-ascend 把 torch 降到 2.10.0
#         并引入 torch-npu，与历史可用环境（vllm-ascend v0.23.0rc1）形态一致。
# 注意 3：pip 把可执行脚本装到 /opt/buildtools/python-3.11.4/bin，而该目录不在 PATH 上
#         （构建日志：WARNING: The script vllm is installed in
#          '/opt/buildtools/python-3.11.4/bin' which is not on PATH）。
#         base 镜像的 python_3.11.4.sh 是靠 `ln -sf ${install_dir}/bin/* /usr/local/bin`
#         让脚本在 PATH（/usr/local/bin）可见，但那只覆盖 base 构建时的脚本；本层新装的
#         vllm 无软链，故 presmoke 运行时 subprocess 找不到 'vllm'
#         （FileNotFoundError: 'vllm'）。这里补一次同款软链，暴露新脚本到 /usr/local/bin。
# 注意 4：vllm 0.23.0 -> tilelang 0.1.9 -> ml-dtypes（未钉版本）。第一条命令装 vllm 时
#         numpy 尚未被限制，pip 拿到 ml_dtypes 0.7.0（声明 numpy>=2.0.0）；第二条命令把
#         numpy 降到 1.26.4 后，ml_dtypes 0.7.0 未回退，二者 ABI 不匹配：vllm 启动即崩
#         （RuntimeError: module was compiled against NumPy C-API version 0x12 (NumPy 2.0)
#          but the running NumPy has C-API version 0x11 -> ImportError: numpy._core.multiarray
#          failed to import -> vLLM server did not become ready within 600s）。
#         故在第二条命令显式钉 ml_dtypes==0.5.1（声明 numpy>=1.23.3，兼容 numpy 1.26.4）。
RUN python3 -m pip config set global.index-url ${PIP_INDEX_URL} \
 && python3 -m pip config set global.extra-index-url "${PIP_EXTRA_INDEX_URL} https://mirrors.aliyun.com/pypi/web/simple" \
 && python3 -m pip install --no-cache-dir \
        --extra-index-url https://download.pytorch.org/whl/cpu/ \
        vllm==0.23.0 \
 && python3 -m pip install --no-cache-dir \
        vllm-ascend==0.23.0rc1 \
        triton-ascend==3.2.1 \
        mooncake-transfer-engine-npu==0.3.11.post1 \
        ml_dtypes==0.5.1 \
        pytest \
        librosa \
        einops \
 && ln -sf /opt/buildtools/python-3.11.4/bin/* /usr/local/bin \
 && python3 -m pip cache purge

CMD ["/bin/bash"]
