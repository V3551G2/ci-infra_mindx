FROM quay.io/ascend/cann:9.1.0-910b-ubuntu22.04-py3.12

ARG PIP_INDEX_URL="https://mirrors.tuna.tsinghua.edu.cn/pypi/web/simple"

WORKDIR /workspace

# Install clang-15 (for triton-ascend) and Mooncake
ARG MOONCAKE_TAG=0.3.11.post1
RUN apt-get update -y && \
    apt-get install -y --no-install-recommends git vim wget net-tools gcc g++ cmake numactl libnuma-dev libibverbs-dev libjemalloc2 libhiredis-dev clang-15 && \
    update-alternatives --install /usr/bin/clang clang /usr/bin/clang-15 20 && \
    update-alternatives --install /usr/bin/clang++ clang++ /usr/bin/clang++-15 20 && \
    source /usr/local/Ascend/ascend-toolkit/set_env.sh && \
    python3 -m pip install mooncake-transfer-engine-npu==${MOONCAKE_TAG} --extra-index-url https://mirrors.aliyun.com/pypi/web/simple && \
    rm -rf /var/cache/apt/* && \
    rm -rf /var/lib/apt/lists/*

# Install modelscope (for fast download) and ray (for multinode)
RUN pip config set global.index-url ${PIP_INDEX_URL} && \
    python3 -m pip install --no-cache-dir modelscope 'ray>=2.47.1,<=2.48.0' 'protobuf>3.20.0' && \
    python3 -m pip cache purge

# Install vLLM + vllm-ascend
ARG VLLM_REPO=https://github.com/vllm-project/vllm.git
ARG VLLM_TAG=v0.23.0
ARG VLLM_COMMIT=""

# ci-infra 的 build context 是 image/MultimodalSDK/（不是 vllm-ascend 仓库），
# 无法使用官方 Dockerfile 的 `COPY . /vllm-workspace/vllm-ascend/`（context 里没有
# vllm-ascend 源码，后续 `pip install -e` 会报 does not appear to be a Python project）。
# 改为按 tag 克隆源码，tag 与 pip 依赖 vllm-ascend==0.23.0rc1 对齐。
ARG VLLM_ASCEND_REPO=https://github.com/vllm-project/vllm-ascend.git
ARG VLLM_ASCEND_TAG=v0.23.0rc1

ARG SOC_VERSION="ascend910b1"
ARG COMPILE_CUSTOM_KERNELS=1
ENV DEBIAN_FRONTEND=noninteractive
ENV SOC_VERSION=$SOC_VERSION \
    TASK_QUEUE_ENABLE=1 \
    OMP_NUM_THREADS=1

# 体积优化：vllm 与 vllm-ascend 的依赖树重叠且版本互斥——vllm 0.23.0 会拉入
# torch-2.11/2.15+cpu、transformers 5.24、numpy 2.3，随后 vllm-ascend 0.23.0rc1 又把
# torch 改回 ==2.10.0（torch-npu==2.10.0.post2）、transformers 5.5.4、numpy==1.26.4。
# 若两者分两层安装，前序层里这些"将被覆盖"的旧文件会作为死重永久留在镜像中
# （单阶段删文件无法回收）。因此把「克隆 vllm + 装 vllm + 克隆 vllm-ascend +
# 装 vllm-ascend + 装 triton-ascend」合并进同一个 RUN 层：同一路径被覆盖后只保留
# 最终版本，并统一清掉源码 .git、__pycache__ 与 CMake 中间产物 build/。
RUN if [ -n "$VLLM_COMMIT" ]; then \
      git init /vllm-workspace/vllm && \
      git -C /vllm-workspace/vllm fetch --depth 1 $VLLM_REPO "$VLLM_COMMIT" && \
      git -C /vllm-workspace/vllm checkout FETCH_HEAD; \
    else \
      git clone --depth 1 -b $VLLM_TAG $VLLM_REPO /vllm-workspace/vllm; \
    fi && \
    git clone --depth 1 -b ${VLLM_ASCEND_TAG} ${VLLM_ASCEND_REPO} /vllm-workspace/vllm-ascend && \
    VLLM_TARGET_DEVICE="empty" python3 -m pip install --no-cache-dir -e /vllm-workspace/vllm/[audio] --extra-index https://download.pytorch.org/whl/cpu/ && \
    python3 -m pip uninstall -y triton && \
    export PIP_EXTRA_INDEX_URL="https://mirrors.huaweicloud.com/ascend/repos/pypi" && \
    export VLLM_BATCH_INVARIANT=1 && \
    source /usr/local/Ascend/ascend-toolkit/set_env.sh && \
    source /usr/local/Ascend/nnal/atb/set_env.sh && \
    python3 -m pip install --no-cache-dir -e /vllm-workspace/vllm-ascend/ --extra-index https://download.pytorch.org/whl/cpu/ && \
    python3 -m pip uninstall -y triton triton-ascend && \
    python3 -m pip install --no-cache-dir triton-ascend==3.2.1 --extra-index-url https://mirrors.huaweicloud.com/ascend/repos/pypi && \
    python3 -m pip install --no-cache-dir concurrent-log-handler && \
    python3 -m pip cache purge && \
    rm -rf /vllm-workspace/vllm/.git /vllm-workspace/vllm-ascend/.git && \
    find /vllm-workspace -type d -name '__pycache__' -prune -exec rm -rf {} \; && \
    rm -rf /vllm-workspace/vllm-ascend/build

# PreSmoke 用例的真实运行依赖：run_presmoke.sh 会执行 `pip3 install librosa`。
# 镜像内若没有 librosa，该命令会把数值栈升级到 librosa 1.0.1 要求的 numpy>=2.1
# （实测升到 numpy 2.5.5 / scipy 1.18.1 / decorator 5.3.2），直接破坏 triton-ascend
# 要求的 numpy==1.26.4 / scipy==1.13.1 / decorator==5.1.1，进而危及 vLLM 栈。
# 这里预装 librosa 并用 constraints 固定数值栈，使运行时那条 pip 安装变成
# "Requirement already satisfied" 的 no-op，保证测试环境与 triton-ascend 自洽。
RUN printf 'numpy==1.26.4\nscipy==1.13.1\ndecorator==5.1.1\n' > /tmp/presmoke_constraints.txt && \
    python3 -m pip install --no-cache-dir librosa -c /tmp/presmoke_constraints.txt && \
    python3 -m pip cache purge && \
    rm -f /tmp/presmoke_constraints.txt

# Append `libascend_hal.so` path (devlib) to LD_LIBRARY_PATH
RUN echo "export LD_PRELOAD=/usr/lib/$(uname -m)-linux-gnu/libjemalloc.so.2:$LD_PRELOAD" >> ~/.bashrc
RUN echo "export LD_LIBRARY_PATH=$LD_LIBRARY_PATH:/usr/local/lib" >> ~/.bashrc

# 体积优化（A 档，低风险）：删除 CANN 中仅用于开发/调试/CPU 仿真、运行期不会被加载的组件
# （约 0.86GB）。刻意保留 devlib（含 libascend_hal.so 等链接桩）、lib64 动态库、bishengir/
# bisheng_compiler/hcc 编译链、ops_transformer/ops_nn/ops_cv/ops_legacy 预编译内核，
# 以及 nnal/atb 全量——这些都可能是运行期或后续 JIT 回退所需。
#
# 注意：/usr/local/Ascend 来自基础镜像的单个 COPY 层（10.6GB）。单阶段 Dockerfile 中删除
# 其子目录只会新增白化条目，`docker images` 体积不变；因此必须配合 docker_build.sh 中的
# “压平(squash)”（docker export | docker import）步骤，让被删除的真实文件从镜像中消失。
RUN echo "[size] /usr/local/Ascend before trim:" && du -sh /usr/local/Ascend && \
    rm -rf \
      /usr/local/Ascend/cann-9.1.0/aarch64-linux/simulator \
      /usr/local/Ascend/cann-9.1.0/aarch64-linux/include \
      /usr/local/Ascend/cann-9.1.0/aarch64-linux/pkg_inc \
      /usr/local/Ascend/cann-9.1.0/tools/msdebug \
      /usr/local/Ascend/cann-9.1.0/tools/profiler \
      /usr/local/Ascend/cann-9.1.0/tools/mssanitizer \
      /usr/local/Ascend/cann-9.1.0/tools/msopprof \
      /usr/local/Ascend/cann-9.1.0/tools/cpudebug \
      /usr/local/Ascend/cann-9.1.0/tools/msmemscope \
      /usr/local/Ascend/cann-9.1.0/tools/ascend_system_advisor \
      /usr/local/Ascend/cann-9.1.0/tools/mstx \
      /usr/local/Ascend/cann-9.1.0/tools/hccl_test \
      /usr/local/Ascend/cann-9.1.0/tools/opbuild \
      /usr/local/Ascend/cann-9.1.0/tools/msopgen \
      /usr/local/Ascend/cann-9.1.0/tools/operator_cmp \
      /usr/local/Ascend/cann-9.1.0/tools/op_project_templates \
      /usr/local/Ascend/cann-9.1.0/tools/new_op_project_template \
      /usr/local/Ascend/cann-9.1.0/tools/show_kernel_debug_data \
      /usr/local/Ascend/cann-9.1.0/tools/optype_collector \
      /usr/local/Ascend/cann-9.1.0/tools/msobjdump \
      /usr/local/Ascend/cann-9.1.0/tools/ms_fmk_transplt \
      /usr/local/Ascend/cann-9.1.0/opp/built-in/op_impl/ai_core/tbe/kernel/ascend910_93 && \
    find /usr/local/Ascend -type f -name '*.whl' -delete && \
    find /usr/local/Ascend -type f -name '*.a' -delete && \
    echo "[size] /usr/local/Ascend after trim:" && du -sh /usr/local/Ascend

CMD ["/bin/bash"]