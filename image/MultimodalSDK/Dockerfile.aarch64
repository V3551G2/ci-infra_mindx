# syntax=docker/dockerfile:1
# =============================================================================
# MultimodalSDK 门禁编译镜像（aarch64）
#
# 用途：
#   1) GitCode 门禁 / CodeArts 夜间构建：build_script/build_merge.sh
#      - fetch_deps.sh 下载 opensource.tar.gz（FFmpeg/turbojpeg/soxr 预编译库）
#      - CMake 编译 AccSDK（C++17 + swig 生成 python 绑定）
#      - python setup.py bdist_wheel 打包 MultimodalSDK
#      - makeself 打包产物，obsutil 上传
#   2) 编译需 source /usr/local/Ascend/ascend-toolkit/set_env.sh（CANN），
#      并链接 /usr/local/Ascend/driver/lib64 下的 libsecurec.so（HDK）
#
# 真实依赖（依据 .gitcode/workflows + build_script + AccSDK/CMakeLists 确认）：
#   系统  ：gcc/g++/make/cmake/swig/git/wget/curl/unzip/patch/pkg-config 及 Python 构建头文件
#   NPU   ：Ascend HDK 驱动 + CANN 8.3.RC2（toolkit/kernels/nnal/device-sdk）
#   Python：3.11.4 + torch/torch-npu/torchvision/transformers/pillow/numpy/einops/opencv-python
#   工具  ：obsutil（制品上传）、lcov（覆盖率）、cmake 3.28.2、swig 4.3.0
#
# 相对于通用镜像（mindx_ubuntu_Arm_docker_img）移除的冗余组件：
#   Volcano、Go 及 gocov/gocov-html/gotestsum、devtoolset-7、gcc-7.5.0（源码编译）、
#   faiss+OpenBLAS、meson、ninja、mindspore-lite、make-4.4.1、mockcpp、googletest、
#   models、libboost-all-dev、npm/nodejs、gfortran/libgfortran-11-dev、
#   texinfo/gawk/unar/symlinks/rpm/cpio（devtoolset 专用）、libcapture-tiny-perl/libdatetime-perl
#   上述组件经全仓 grep 校验，MultimodalSDK 编译流程均未引用。
# =============================================================================
FROM ubuntu:22.04

ARG DEBIAN_FRONTEND=noninteractive
ENV DEBIAN_FRONTEND=${DEBIAN_FRONTEND}

# =============================================================================
# 1. 系统基础依赖（一次性装齐 + 立即清理 apt 缓存）
#    仅保留编译工具链、下载解压工具与 Python/C++ 编译所需头文件。
# =============================================================================
RUN apt-get update && apt-get install -y --no-install-recommends \
        gcc-9 g++-9 build-essential make pkg-config \
        automake autoconf libtool bison flex sudo \
        git wget curl unzip tar patch dos2unix vim ca-certificates \
        libffi-dev zlib1g-dev libssl-dev openssl \
        libbz2-dev liblzma-dev libsqlite3-dev libc-dev libpcre2-dev \
        libnuma-dev numactl \
        libcapture-tiny-perl libdatetime-perl \
    && update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-9 90 \
    && update-alternatives --install /usr/bin/g++ g++ /usr/bin/g++-9 90 \
    && update-alternatives --set gcc /usr/bin/gcc-9 \
    && update-alternatives --set g++ /usr/bin/g++-9 \
    && update-alternatives --install /usr/bin/cc cc /usr/bin/gcc 100 \
    && update-alternatives --install /usr/bin/c++ c++ /usr/bin/g++ 100 \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/*

# wget 静默下载（verbose=off 关闭点状进度以精简日志，仍保留错误信息便于定位失败 URL）
RUN printf 'verbose = off\n' > /root/.wgetrc

WORKDIR /opt/buildtools

# =============================================================================
# 2. OBS 客户端（CodeArts 夜间构建上传产物用）
# =============================================================================
COPY script/obsutil.sh /script/obsutil.sh
RUN bash /script/obsutil.sh \
    && rm -f /opt/buildtools/obsutil_linux_*.tar.gz

# =============================================================================
# 3. Python 3.11.4（自编译，耗时长，靠前放置便于后续层复用缓存）
# =============================================================================
COPY script/python_3.11.4.sh /script/python_3.11.4.sh
RUN bash /script/python_3.11.4.sh \
    && rm -rf /root/.cache/pip /opt/buildtools/Python-3.11.4*

# =============================================================================
# 4. CMake 3.28.2（AccSDK 编译依赖，cmake_minimum_required 3.14.1）
# =============================================================================
COPY script/cmake_3.28.2.sh /script/cmake_3.28.2.sh
RUN bash /script/cmake_3.28.2.sh \
    && rm -f /opt/buildtools/v3.28.2.tar.gz

# =============================================================================
# 5. SWIG 4.3.0（AccSDK py 绑定生成：find_package(SWIG) + UseSWIG；内含 bison 源码编译）
# =============================================================================
COPY script/swig_4.3.0.sh /script/swig_4.3.0.sh
RUN bash /script/swig_4.3.0.sh \
    && rm -rf /opt/buildtools/bison-3.8.2* /opt/buildtools/swig-4.3.0.tar.gz

# =============================================================================
# 6. Ascend HDK 驱动 + CANN 8.3.RC2（NPU 编译必需，build.sh source set_env.sh）
# =============================================================================
COPY script/Ascend_HDK_25.3.RC1.B097.sh /script/Ascend_HDK_25.3.RC1.B097.sh
COPY script/cann_8.3.RC2.B030.sh /script/cann_8.3.RC2.B030.sh
RUN bash /script/Ascend_HDK_25.3.RC1.B097.sh \
    && bash /script/cann_8.3.RC2.B030.sh

# =============================================================================
# 7. torch-npu（NPU 侧 torch 插件，编译/测试用例依赖）
# =============================================================================
COPY script/torch-npu_2.1.0.sh /script/torch-npu_2.1.0.sh
RUN bash /script/torch-npu_2.1.0.sh

# =============================================================================
# 8. lcov 2.1（代码覆盖率统计，build_merge.sh 要求 lcov>=2.0）
# =============================================================================
COPY script/lcov_2.1.sh /script/lcov_2.1.sh
RUN bash /script/lcov_2.1.sh \
    && rm -rf /opt/buildtools/lcov

USER root
