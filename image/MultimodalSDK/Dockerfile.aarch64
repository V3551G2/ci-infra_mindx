# syntax=docker/dockerfile:1
# =============================================================================
# MultimodalSDK 门禁镜像（aarch64）—— Build_Arm（编译）与 UT_cpp（单测）统一底座
#
# 说明：门禁 Build_Arm 与 UT_cpp 两个任务已合并使用同一镜像
#   （UT 依赖为编译依赖的超集）。本文件由原 Dockerfile_ut.aarch64 演进而来，
#   原独立编译 Dockerfile 已删除；下文以 [UT 专用] 标注「仅单元测试需要、
#   编译任务不使用」的依赖。
#
# 用途：
#   1) Build_Arm（.build_job.yml）：build_script/build_merge.sh 编译 AccSDK
#      （C++17 + swig 生成 python 绑定）、python setup.py bdist_wheel 打包、
#      makeself 打包产物，obsutil 上传。
#   2) UT_cpp（.ut_cpp.yml）：build_merge.sh test，编译/链接仓内
#      acc_data/3rdparty/gtest（googletest 由 CI 在仓内源码编译，镜像无需预置），
#      make test 跑 C++ 单测；gen_report.sh 用 lcov 生成 C++ 覆盖率；
#      MultimodalSDK pytest（coverage）跑 python 单测并打包 makeself。
#   编译/测试期 source /usr/local/Ascend/ascend-toolkit/set_env.sh（CANN），
#   并链接 /usr/local/Ascend/driver/lib64 下 libsecurec.so（HDK）。
#
# 真实依赖（依据 .gitcode/workflows + build_script + AccSDK/CMakeLists 确认）：
#   系统  ：gcc/g++/make/cmake/swig/git/wget/curl/unzip/patch/pkg-config 及 Python 构建头文件
#   NPU   ：Ascend HDK 驱动（libsecurec.so）+ CANN 8.3.RC2 toolkit（libascendcl + set_env.sh）
#   Python：3.11.4 + torch-npu/torch/torchvision/transformers/pillow/numpy/einops/opencv-python
#           + pytest/pytest-cov/pytest-html/coverage（UT 实跑）
#   工具  ：obsutil（制品上传）、lcov（C++ 覆盖率）、cmake 3.28.2、swig 4.3.0
#
# 相对通用镜像（mindx_ubuntu_Arm_docker_img / SDK_20260112_1，约 26GB）移除的冗余组件：
#   Volcano、Go 及 gocov/gocov-html/gotestsum、devtoolset-7、gcc-7.5.0（源码编译）、
#   faiss+OpenBLAS、meson、ninja、mindspore-lite、make-4.4.1、mockcpp、googletest-1.11.0、
#   models、libboost-all-dev、npm/nodejs、gfortran/libgfortran-11-dev、
#   texinfo/gawk/unar/symlinks/rpm/cpio（devtoolset 专用）、
#   CANN kernels-310p/nnal/device-sdk（minios，全仓无引用）、
#   torch-npu 2.1.0（CI 实跑会重装 2.9.1，镜像预装版本被覆盖）。
#   上述组件经全仓 grep 校验，MultimodalSDK 编译/UT 流程均未引用。
# =============================================================================
FROM ubuntu:22.04

ARG DEBIAN_FRONTEND=noninteractive
ENV DEBIAN_FRONTEND=${DEBIAN_FRONTEND}

# =============================================================================
# 1. 系统基础依赖（一次性装齐）
#    仅保留编译工具链、下载解压工具与 Python/C++ 编译所需头文件；
#    libcapture-tiny-perl/libdatetime-perl 为 lcov 2.x 运行所需的 perl 模块。
#    带 [UT 专用] 标记的包仅单元测试任务需要，编译任务不使用。
# =============================================================================
RUN apt-get update && apt-get install -y --no-install-recommends \
        gcc-9 g++-9 build-essential make pkg-config \
        automake autoconf libtool bison flex sudo \
        git \
        # [UT 专用] git-lfs：.ut_cpp.yml 首个步骤执行 apt install -y git git-lfs 与
        #   git lfs pull，测试视频 AccSDK/test/data/videos/*.mp4 为 LFS 指针，缺则失败
        git-lfs \
        wget curl unzip tar patch dos2unix vim ca-certificates \
        libffi-dev zlib1g-dev libssl-dev openssl \
        libbz2-dev liblzma-dev libsqlite3-dev libc-dev libpcre2-dev \
        libnuma-dev numactl \
        # [UT 专用] opencv-python(cv2) 与 torchvision 运行时依赖，并传递引入 libxcb1；
        #   libgomp1 供 torch OpenMP 使用。缺则 Python UT 收集阶段报
        #   ImportError: libxcb.so.1: cannot open shared object file
        libgl1 libglib2.0-0 libgomp1 libxcb1 \
        libcapture-tiny-perl libdatetime-perl \
    && update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-9 90 \
    && update-alternatives --install /usr/bin/g++ g++ /usr/bin/g++-9 90 \
    && update-alternatives --set gcc /usr/bin/gcc-9 \
    && update-alternatives --set g++ /usr/bin/g++-9 \
    && update-alternatives --install /usr/bin/cc cc /usr/bin/gcc 100 \
    && update-alternatives --install /usr/bin/c++ c++ /usr/bin/g++ 100 \
    && rm -rf /var/cache/apt/*
# [UT 专用] 刻意保留 /var/lib/apt/lists（不清空）：使运行期 apt install -y git git-lfs
#   能在无外网时判定为「已安装最新版」并返回 0，避免门禁步骤因缺包索引报错。

# wget 静默下载（verbose=off 关闭点状进度以精简日志，仍保留错误信息便于定位失败 URL）
RUN printf 'verbose = off\n' > /root/.wgetrc

WORKDIR /opt/buildtools

# =============================================================================
# 2. OBS 客户端（CodeArts 夜间构建上传产物用）
# =============================================================================
COPY script/obsutil.sh /script/obsutil.sh
RUN bash /script/obsutil.sh \
    && rm -f /opt/buildtools/obsutil_linux_*.tar.gz

# =============================================================================
# 3. Python 3.11.4（自编译，耗时长，靠前放置便于后续层复用缓存）
#    内含编译与 UT 实跑所需的 torch-npu/torchvision/transformers 与 pytest/coverage，
#    避免每次任务在线重复下载。
# =============================================================================
COPY script/python_3.11.4.sh /script/python_3.11.4.sh
RUN bash /script/python_3.11.4.sh \
    && rm -rf /root/.cache/pip /opt/buildtools/Python-3.11.4*

# =============================================================================
# 4. CMake 3.28.2（AccSDK 编译依赖，cmake_minimum_required 3.14.1）
# =============================================================================
COPY script/cmake_3.28.2.sh /script/cmake_3.28.2.sh
RUN bash /script/cmake_3.28.2.sh \
    && rm -f /opt/buildtools/v3.28.2.tar.gz

# =============================================================================
# 5. SWIG 4.3.0（AccSDK py 绑定生成：find_package(SWIG) + UseSWIG；内含 bison 源码编译）
# =============================================================================
COPY script/swig_4.3.0.sh /script/swig_4.3.0.sh
RUN bash /script/swig_4.3.0.sh \
    && rm -rf /opt/buildtools/bison-3.8.2* /opt/buildtools/swig-4.3.0 /opt/buildtools/swig-4.3.0.tar.gz

# =============================================================================
# 6. Ascend HDK 驱动（libsecurec.so）+ CANN 8.3.RC2 toolkit（ascendcl/set_env.sh）
#    门禁仅链接 ascendcl + libsecurec，不编译算子内核，故不装 kernels/nnal/minios。
# =============================================================================
COPY script/Ascend_HDK_25.3.RC1.B097.sh /script/Ascend_HDK_25.3.RC1.B097.sh
COPY script/cann_8.3.RC2.B030.sh /script/cann_8.3.RC2.B030.sh
RUN bash /script/Ascend_HDK_25.3.RC1.B097.sh \
    && bash /script/cann_8.3.RC2.B030.sh

# =============================================================================
# 7. lcov 2.1（C++ 覆盖率：AccSDK/build_script/gen_report.sh 使用 lcov/genhtml；
#    build_merge.sh 检测到系统 lcov>=2.0 时直接复用，省去在线下载编译 lcov-2.0）
# =============================================================================
COPY script/lcov_2.1.sh /script/lcov_2.1.sh
RUN bash /script/lcov_2.1.sh \
    && rm -rf /opt/buildtools/lcov

USER root
