# syntax=docker/dockerfile:1
# =====================================================================
# 门禁镜像：UT_cpp（tag: mindcluster-ut_cpp-x86_64）
#
# 任务入口（Ascend/mind-cluster）：
#   .gitcode/workflows/.ut_cpp.yml                    # UT_cpp job 定义
#     └─ .gitcode/workflows/scripts/ut_cpp_execute.sh # 容器内执行入口
#          └─ component/ascend-docker-runtime/cli/test/dt/build.sh
#
# 该 job 只做 ascend-docker-runtime 的 cli 单元测试 + lcov 覆盖率：
#   1. yaml 步骤在容器内 git clone mockcpp v2.7 / googletest 1.10.0 / libboundscheck v1.1.10
#   2. build.sh 用 cmake + make 编译 gtest / mockcpp / libboundscheck / cli，产出 ut_demo
#   3. 运行 ut_demo，再用 lcov + genhtml 生成覆盖率报告
#
# 因此镜像只需要 C/C++ 编译链 + cmake + lcov，不需要 Go / Python / musl / volcano。
# 原 Dockerfile 额外安装了 golang 1.20.7、python 3.9.11、musl 1.2.0、volcano v1.4/v1.7
# 源码及 gocov/gotestsum 等 go 工具——这些属于 Build / UT_go / UT_python 任务，UT_cpp
# 全程不使用，已全部删除；同时把基础镜像从 codeci ubuntu18（内含 JDK/mvn/ant，约 700MB）
# 换成干净的 ubuntu:22.04。
#
# 关键约束：
#   - gcc 固定为 9：mockcpp v2.7 / googletest 1.10.0 是 2019 年前后的产物，与 gcc-9
#     同期，避免新版 gcc 下的编译告警/报错（与 IndexSDK ut_cpp 镜像同一策略）。
#   - lcov 用发行版 1.14：build.sh 依赖 `--rc lcov_branch_coverage=1`（lcov 2.x 已移除）。
#   - 运行期不做 apt-get/pip 安装，故安装后直接删除 /var/lib/apt/lists 索引以进一步瘦身。
# =====================================================================
FROM ubuntu:22.04

ARG DEBIAN_FRONTEND=noninteractive
ENV DEBIAN_FRONTEND=${DEBIAN_FRONTEND}

# ---------------------------------------------------------------------
# 系统依赖（单层安装 + 立即清理 apt 缓存）
#   build-essential / gcc-9,g++-9 : C/C++ 编译链（并把默认编译器回退到 gcc-9）
#   cmake                         : build.sh 构建 gtest / mockcpp / libboundscheck / cli
#   lcov                          : 覆盖率采集与报告（自带 genhtml 及其 perl 依赖）
#   git                           : yaml 步骤在容器内 clone 三方 UT 框架源码
#   ca-certificates               : 上述 git https clone 的证书校验
# ---------------------------------------------------------------------
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        gcc-9 \
        g++-9 \
        cmake \
        lcov \
        git \
        ca-certificates \
    && update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-9 90 \
    && update-alternatives --install /usr/bin/g++ g++ /usr/bin/g++-9 90 \
    && update-alternatives --install /usr/bin/cc cc /usr/bin/gcc-9 90 \
    && update-alternatives --install /usr/bin/c++ c++ /usr/bin/g++-9 90 \
    && gcc --version \
    && cmake --version \
    && lcov --version \
    && git --version \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/*

WORKDIR /opt/buildtools

USER root
