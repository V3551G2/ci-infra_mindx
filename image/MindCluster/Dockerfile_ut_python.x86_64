# syntax=docker/dockerfile:1
# =====================================================================
# 门禁镜像：ut_python / ut_mindio_cpp 测试环境
# 使用方：Ascend/mind-cluster 的 UT_python 与 UT_mindio_cpp 两个 job
#         （见 .gitcode/workflows/PR-pipeline_mindcluster.yml L254-276，二者共用同一镜像）
# 执行入口：
#   UT_python      : .ut_python.yml      -> scripts/ut_python_execute.sh
#   UT_mindio_cpp  : .ut_mindio_cpp.yml  -> scripts/ut_mindio_cpp_execute.sh
# 真实依赖：
#   UT_python      三条 python 分支：taskd(pytest) / ascend-clusterops-agent(pytest)
#                  / mindio-acp(cmake 构建 + pytest)
#   UT_mindio_cpp  C++ gtest：需 gcc/g++/make/cmake + lcov/genhtml + SWIG
# 关键约束：
#   - Python 固定 3.9.11（执行脚本硬编码 /opt/buildtools/python-3.9.11）
#   - SWIG 必须 >=4.2.0（mindio acp abi3 wheel 要求，见 build/README.md）
#   - 运行时会 apt-get install / pip install，故保留 /var/lib/apt/lists 索引
# =====================================================================
FROM ubuntu:22.04

ARG DEBIAN_FRONTEND=noninteractive
ENV DEBIAN_FRONTEND=${DEBIAN_FRONTEND}

# ---------------------------------------------------------------------
# 1. 系统依赖（一次装齐，单层合并）
#    - build-essential：gcc/g++/make（mindio acp 编译 + gtest）
#    - cmake：Ubuntu22.04 自带 3.22.1，满足 mindio 的 >=3.14.1，无需源码编译
#    - lcov：mindio_cpp 覆盖率 genhtml
#    - libnuma-dev/numactl：ubs-comm 依赖 <numa.h>
#    - 其余为 Python3.9.11 编译依赖与下载/转换工具（git/wget/dos2unix 等）
#    已移除：volcano、golang、musl、obsutil、gocov/gotestsum、nodejs/npm、
#            vim/unar/symlinks/rpm/cpio、bison/flex、autoconf/automake/libtool 等
#            （均不在上述两条执行链中被使用）
# ---------------------------------------------------------------------
RUN apt-get update \
    && apt-get -y install \
        build-essential \
        cmake \
        lcov \
        git \
        wget \
        curl \
        unzip \
        ca-certificates \
        dos2unix \
        libffi-dev \
        zlib1g-dev \
        libssl-dev \
        libsqlite3-dev \
        libbz2-dev \
        liblzma-dev \
        libnuma-dev \
        numactl \
    && rm -rf /var/cache/apt/*

# wget 静默下载（保留报错信息，仅关闭点状进度输出）
RUN printf 'quiet = on\n' > /root/.wgetrc

WORKDIR /opt/buildtools

# ---------------------------------------------------------------------
# 2. Python 3.9.11（自编译，最耗时，前置以复用构建缓存）+ pip 预装 UT 依赖
#    - SWIG：用 pip 安装 4.2.x（仓库文档推荐，满足 abi3 的 >=4.2.0 要求），
#      取代原来"编译 bison + autogen swig 源码"的慢路径
#    - 安装后清理源码/tarball/pip 缓存以减小体积
# ---------------------------------------------------------------------
COPY script/python_3.9.11.sh /script/python_3.9.11.sh
RUN bash /script/python_3.9.11.sh \
    && pip3 install --no-cache-dir "swig>=4.2,<4.4" \
    && ln -sf /opt/buildtools/python-3.9.11/bin/swig /usr/local/bin/swig \
    && swig -version \
    && rm -rf /opt/buildtools/Python-3.9.11* /root/.cache/pip

USER root
