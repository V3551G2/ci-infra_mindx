# syntax=docker/dockerfile:1
FROM ubuntu:22.04

ARG DEBIAN_FRONTEND=noninteractive
ENV DEBIAN_FRONTEND=${DEBIAN_FRONTEND}

# ============================================================================
# 1. 系统基础依赖（一次性装齐 + 立即清理 apt 缓存）
#    RAGSDK 编译为纯 Python wheel 打包（setup.py bdist_wheel），无 C/C++/Go/NPU
#    编译步骤，仅需 Python 解释器 + 常用 shell 打包工具（git/unzip/patch 等）。
# ============================================================================
RUN apt-get update && apt-get install -y --no-install-recommends \
        texinfo gawk gcc-9 g++-9 unar symlinks git wget unzip \
        libffi-dev zlib1g-dev sudo libssl-dev openssl sqlite3 libsqlite3-dev \
        libnuma-dev numactl libpcre2-dev bison flex build-essential automake \
        autoconf libtool libbz2-dev rpm cpio liblzma-dev dos2unix curl vim \
        libc-dev lcov npm nodejs gfortran libgfortran-11-dev libboost-all-dev \
        pkg-config \
    && update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-9 90 \
    && update-alternatives --install /usr/bin/g++ g++ /usr/bin/g++-9 90 \
    && update-alternatives --set gcc /usr/bin/gcc-9 \
    && update-alternatives --set g++ /usr/bin/g++-9 \
    && update-alternatives --install /usr/bin/cc cc /usr/bin/gcc 100 \
    && update-alternatives --install /usr/bin/c++ c++ /usr/bin/g++ 100 \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/*

# wget 静默下载（verbose=off 取消点状进度但保留报错，不影响问题定位）
RUN printf 'verbose = off\n' > /root/.wgetrc

WORKDIR /opt/buildtools

# ============================================================================
# 2. Python 3.11.4（自编译，RAGSDK 编译仅需 Python 解释器 + setuptools/wheel）
# ============================================================================
COPY script/python_3.11.4.sh /script/python_3.11.4.sh
RUN bash /script/python_3.11.4.sh \
    && rm -rf /root/.cache/pip /opt/buildtools/Python-3.11.4*

# ============================================================================
# 3. OBS 客户端（制品上传）
# ============================================================================
COPY script/obsutil.sh /script/obsutil.sh
RUN bash /script/obsutil.sh \
    && rm -f /opt/buildtools/obsutil_linux_amd64.tar.gz

USER root