# syntax=docker/dockerfile:1
# =============================================================================
# AgentSDK PreSmoke_aura 任务镜像（aarch64）
#
# 任务入口（AgentSDK 仓库）：
#   .gitcode/workflows/PR-pipeline_full.yml
#     -> PreSmoke_aura  (uses: .gitcode/workflows/.presmoke.yml)
#         runs-on: [dedicate-hosted, arm64, npu, large]
#         container.image = swr.cn-north-4.myhuaweicloud.com/ascend-mindx/mindx_arm:AgentSDK_26.0.0
#           SMOKE_SCRIPT  = run_presmoke_aura.sh
#           SMOKE_COMPONENT = AgentSDK   (SMOKE_SCRIPT_PATH = 仓库根目录)
#           CHANGE_PATTERN = aura/|presmoke/aura/
#
# 执行链：
#   run_presmoke_aura.sh
#     -> presmoke/aura/presmoke.sh
#          -> pip install mlflow / ray==2.55.1 (脚本运行期自装，本镜像已预装使其离线 no-op)
#          -> pytest presmoke/aura/cases/test_endtoend.py
#               -> 用例通过 `bash aura/scripts/start_rl_with_verl_vllm.sh` 调起真实启动脚本
#                  该脚本做 base.conf/hosts.conf 解析、参数校验，并调用
#                  aura/scripts/base/get_yaml.py / 训练入口做配置解析
#
# 识别出的真实依赖（依据上述 workflow、presmoke.sh、test_endtoend.py、
# start_rl_with_verl_vllm.sh、base/utils.sh、parse_infer_config.sh）：
#   1) Python 3.11.4 + pytest 系列：presmoke.sh 以 `pytest ... test_endtoend.py` 运行，
#      且要求容器内已预装 pytest。
#   2) PyYAML：get_yaml.py / 训练脚本解析 yaml 配置使用 `yaml.safe_load`。
#   3) git：workflow 克隆被测仓库；wget/curl/unzip：下载与运行期 pip 安装。
#   4) net-tools(ifconfig) / iproute2(ip)：base/utils.sh 的 config_vc_hosts 与
#      presmoke.sh 的 LOCAL_IP 计算依赖（presmoke.sh 亦会运行期 apt 安装，这里预装以缩短运行期）。
#   5) obsutil：.presmoke.yml 从 OBS 拉取最新构建产物所需（workflow 步骤在容器内执行）。
#
# 关键结论（与旧镜像 mindx_arm:AgentSDK_26.0.0 的差异）：
#   用例均为「配置解析 / CLI 校验」类：Test02~09 断言启动脚本在解析阶段报错退出，
#   Test10 仅断言输出中出现 "mode"（start_rl_with_verl_vllm.sh 的 work_mode 日志即可满足），
#   因此 **不需要** CANN / HDK、torch / torch-npu、vllm / vllm-ascend、MindSpeed /
#   Megatron 等数十 GB 的 NPU 训练运行时（仅按 presmoke.sh 要求预装 mlflow 与 ray==2.55.1）；
#   旧镜像中 12.3GB 的 CANN 层、~2.5GB 的 torch 依赖层全部移除，
#   本镜像仅保留上述 5 类真实依赖，体积显著下降、构建时间大幅缩短。
#
# Python 依赖复用同一份「编译安装 + 环境注册」逻辑（script/python_3.11.4_presmoke.sh），
# 与编译/UT 镜像共用 script/python_3.11.4.sh 保持一致的 Python 环境形态，仅裁剪依赖清单。
# =============================================================================
FROM ubuntu:22.04

ARG DEBIAN_FRONTEND=noninteractive
ENV DEBIAN_FRONTEND=${DEBIAN_FRONTEND}

# -----------------------------------------------------------------------------
# 1. 系统基础依赖：一次性装齐 + 立即清理 apt 缓存
#    - build-essential/pkg-config/各 -dev：编译 Python 3.11 与运行期 pip 源码包
#    - git/wget/curl/unzip/ca-certificates：克隆仓库、OBS 下载、pip 下载
#    - net-tools/iproute2：ifconfig / ip（base/utils.sh、presmoke.sh 依赖）
# -----------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates git wget curl unzip \
        build-essential pkg-config \
        zlib1g-dev libssl-dev libffi-dev libbz2-dev liblzma-dev libsqlite3-dev \
        net-tools iproute2 \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/*

# wget 静默下载（关闭点状进度日志，失败仍返回非 0 便于定位 URL）
RUN printf 'quiet = on\n' > /root/.wgetrc

WORKDIR /opt/buildtools

# -----------------------------------------------------------------------------
# 2. Python 3.11.4（自编译，耗时最长，放前便于后续层复用构建缓存）
#    复用与编译/UT 镜像一致的安装逻辑，但只装 PreSmoke 真实依赖（pytest 系列 + PyYAML）
# -----------------------------------------------------------------------------
COPY script/python_3.11.4_presmoke.sh /script/python_3.11.4_presmoke.sh
ENV PATH=/opt/buildtools/python-3.11.4/bin:${PATH}
RUN bash /script/python_3.11.4_presmoke.sh \
    && rm -rf /root/.cache/pip /opt/buildtools/Python-3.11.4*

# -----------------------------------------------------------------------------
# 2b. aura smoke 运行期依赖预装（关键：使 presmoke.sh 的运行期 pip 安装离线可过）
#     presmoke/aura/presmoke.sh 运行期会执行：
#         pip install mlflow           -i https://mirrors.aliyun.com/pypi/simple
#         pip install ray==2.55.1      -i https://mirrors.aliyun.com/pypi/simple
#         apt update && apt install net-tools iproute2 -y
#     实测运行环境访问不到该 pip 源（pip 报 "from versions: none"），脚本会在此直接失败。
#     这里按脚本相同的包与版本预装，运行期 pip 即命中 "Requirement already satisfied"，
#     无需联网；net-tools/iproute2 已在第 1 节预装。
#     （ray 被 aura 代码广泛 import；mlflow 仅为满足脚本语句，aura 代码未直接 import。）
# -----------------------------------------------------------------------------
RUN pip3 install --no-cache-dir mlflow ray==2.55.1 \
    && rm -rf /root/.cache/pip

# -----------------------------------------------------------------------------
# 3. OBS 客户端（.presmoke.yml 从 OBS 拉取构建产物所需）
# -----------------------------------------------------------------------------
COPY script/obsutil.sh /script/obsutil.sh
RUN bash /script/obsutil.sh \
    && rm -f /opt/buildtools/obsutil_linux_arm64.tar.gz

USER root
